{
  "crons": [
    {
      "path": "/api/cron/sync-results",
      "schedule": "*/30 * * * *",
      "comment": "Sincroniza resultados del Mundial desde API-Football. Requiere plan Pro para frecuencia <1día. En Hobby: usar cron-job.org con Bearer CRON_SECRET."
    },
    {
      "path": "/api/cron/refresh-views",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/daily-streaks",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/weekly-positions",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 3 * * *"
    }
  ]
}
