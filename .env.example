# O2 PRODE — Environment variables example
# Copiar a .env.local con valores reales. NUNCA commitear .env.local.
# Las MISMAS variables hay que cargarlas en Vercel (Settings → Environment
# Variables). NODE_ENV NO va: lo setea Vercel/Next automáticamente.

# ─── Supabase ──────────────────────────────────────────────
# Public — exposed to browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Server-only — never expose to browser
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ─── App ───────────────────────────────────────────────────
# OJO: con protocolo (https://). Se usa para el link de confirmación de email.
NEXT_PUBLIC_APP_URL=https://o2-prode.vercel.app
NEXT_PUBLIC_APP_NAME=O2 PRODE

# ─── Web Push (VAPID) ──────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@o2-prode.app

# ─── Football data (football-data.org) ─────────────────────
# Token de https://www.football-data.org (header X-Auth-Token). La usa el cron
# /api/cron/sync-results para traer resultados en vivo del Mundial 2026.
FOOTBALL_DATA_TOKEN=

# ─── Cron secret ────────────────────────────────────────────
# Cadena aleatoria larga para proteger los endpoints de cron.
# Generar con: openssl rand -hex 32
CRON_SECRET=

# ─── Soporte por email (Resend, server-only) ──────────────
# El panel de admin (/app/admin/soporte) y la auto-captura de errores mandan un
# mail al dueño. Si falta RESEND_API_KEY, el ticket se guarda local (no rompe).
# Setup (2 min): cuenta en resend.com con el MISMO mail destino → API key en
# resend.com/api-keys. Con onboarding@resend.dev se envía a ese mail sin verificar dominio.
RESEND_API_KEY=
SUPPORT_EMAIL_TO=kaistudio.designcraft@gmail.com
SUPPORT_EMAIL_FROM=O2 PRODE <onboarding@resend.dev>

# ─── Auto-captura de errores ───────────────────────────────
# Reporta errores server/cliente deduplicados y los manda por email (la 1ra vez
# que ve cada error). "off" lo apaga. EMAIL_BUDGET = máx mails/hora (anti-flood).
AUTO_ERROR_REPORTING=on
AUTO_ERROR_EMAIL_BUDGET=8
