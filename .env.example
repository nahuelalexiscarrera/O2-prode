# O2 PRODE — Environment variables example
# Copy to .env.local and fill in real values. Never commit .env.local.

# ─── Supabase ──────────────────────────────────────────────
# Public — exposed to browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example

# Server-only — never expose to browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example

# ─── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://o2-prode.app
NEXT_PUBLIC_APP_NAME=O2 PRODE

# ─── Web Push (VAPID) ──────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@o2-prode.app

# ─── Optional analytics (post-MVP) ─────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# ─── Dev only ──────────────────────────────────────────────
NODE_ENV=development

# ─── Football data (football-data.org) ─────────────────────
# Token de https://www.football-data.org (plan premium: live + 20 req/min)
# Header X-Auth-Token. La usa el cron /api/cron/sync-results para traer
# resultados del Mundial 2026. OJO: en Vercel hay que setear esta MISMA var.
FOOTBALL_DATA_TOKEN=

# ─── Cron secret ────────────────────────────────────────────
# Cadena aleatoria larga para proteger los endpoints de cron.
# Generar con: openssl rand -hex 32
# Agregar en Vercel Dashboard → Settings → Environment Variables
CRON_SECRET=

# ─── Soporte por email (Resend, server-only) ──────────────
# El panel de admin (/app/admin/soporte) y la auto-captura de errores mandan un
# mail al dueño del proyecto. Si falta RESEND_API_KEY, el ticket se guarda local
# (no rompe). Setup (2 min): crear cuenta en resend.com con el MISMO mail de
# destino → sacar API key en resend.com/api-keys. Con onboarding@resend.dev se
# puede enviar a ese mail sin verificar dominio.
RESEND_API_KEY=
SUPPORT_EMAIL_TO=kaistudio.designcraft@gmail.com
SUPPORT_EMAIL_FROM=O2 PRODE <onboarding@resend.dev>
# Auto-captura de errores: apagar con "off". Tope de mails de error por hora.
AUTO_ERROR_REPORTING=on
AUTO_ERROR_EMAIL_BUDGET=8

# ─── Auto-captura de errores ───────────────────────────────
# Reporta errores de server/cliente, deduplicados, y crea issue en Jira la
# primera vez que ve cada error. AUTO_ERROR_REPORTING=off lo apaga.
# AUTO_ERROR_JIRA_BUDGET: máx issues automáticos por hora (anti-flood, default 8).
# AUTO_ERROR_REPORTING=off
AUTO_ERROR_JIRA_BUDGET=8
